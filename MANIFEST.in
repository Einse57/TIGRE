# Extra files for the source distribution. The installed package is set in
# pyproject.toml ([tool.setuptools.packages.find]); tests and demos are not
# installed, but are kept in the sdist.
graft Python/tests
graft Python/demos
global-exclude *.py[cod]
prune Python/tests/__pycache__
prune Python/demos/__pycache__
# Files the CUDA/SYCL extensions need that are not on the CUDA source lists
# (PEP 517 sdists, e.g. uv build --sdist, do not go through "python setup.py sdist").
recursive-include Common/CUDA *.hpp *.h *.cuh *.cu *.cpp
recursive-include Common/SYCL *.hpp *.h *.cpp
